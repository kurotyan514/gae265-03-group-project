# 複製成 .env 後依需要修改：cp .env.example .env
# .env 不進 git；compose 與後端（pydantic-settings）都會讀這份

# 環境：local（開發）、test（pytest 自動切換）、production（正式環境）
ENVIRONMENT=local

# 資料庫連線；compose 裡的 backend 會把 POSTGRES_SERVER 覆寫成 db、POSTGRES_PORT 覆寫成 5432
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
# 改密碼要一起改 docker/pgadmin/servers.json，且只在 DB volume 第一次建立時生效
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gae265_03_group_project
# 測試資料庫，名稱必須以 _test 結尾
POSTGRES_TEST_DB=gae265_03_group_project_test

# 開發 compose 對外的 port；跟本機其他服務衝突時改這裡
DB_PORT=5432
PGADMIN_PORT=5050
BACKEND_PORT=8000
FRONTEND_PORT=5173
