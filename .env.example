# 複製成 .env 後依需要修改：cp .env.example .env
# .env 不進 git；compose 與後端（pydantic-settings）都會讀這份

# 環境：local（開發）、test（pytest 自動切換）、production（正式環境）
ENVIRONMENT=local

# 資料庫連線；compose 裡的 backend 會把 POSTGRES_SERVER 覆寫成 db、POSTGRES_PORT 覆寫成 5432
POSTGRES_SERVER=localhost
# 同時是開發 compose 的 db 對外 port 與本機（make test、make migrate）連線的 port，衝突時只改這裡
POSTGRES_PORT=5432
POSTGRES_USER=postgres
# 改密碼要一起改 docker/pgadmin/servers.json，且只在 DB volume 第一次建立時生效
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gae265_03_group_project
# 測試資料庫，名稱必須以 _test 結尾
POSTGRES_TEST_DB=gae265_03_group_project_test

# 開發 compose 對外的 port；跟本機其他服務衝突時改這裡
PGADMIN_PORT=5050
BACKEND_PORT=8000
FRONTEND_PORT=5173

# 費率表與門檻等資料目錄；預設 backend/data，一般不用設
# DATA_DIR=

# LLM 與 embedding 供應商：azure_openai（開發預設，用開發專用 deployment）、openai、ollama
# 所選供應商缺必填設定時後端啟動即報錯；測試一律用 fake，不需要以下任何設定
LLM_PROVIDER=azure_openai

# 條文向量的維度（資料表欄位與 embedding 都用這個值）；Azure／OpenAI 會縮到這個維度，
# Ollama 要選同維度的 model（bge-m3 = 1024）。改了要新的 migration 並重建向量
EMBEDDING_DIMENSIONS=1024

# 條款上傳（ingest agent，僅非 production）：檔案大小上限（MB）、判定為條款至少要切出的條文數
INGEST_MAX_UPLOAD_MB=30
INGEST_MIN_ARTICLES=5
# 內容驗證：條文超過這個字數只提醒（一條一段、不切段，不判錯）
INGEST_VERIFY_LONG_ARTICLE_CHARS=1200
# 內容驗證的程式判定次數：第 1 次驗證後有沒通過的就自動修復再驗證，最多這麼多次（1 = 只驗一次，不修復後再驗）
INGEST_VERIFY_PASSES=2
# LLM 確認「工具不確定」條文的次數（0 = 不用 LLM，這類條文全部進待確認；LLM 只能放行，不能改條文）
INGEST_VERIFY_LLM_PASSES=1
# 檢索自檢：每一條用標題加第一句檢索，前 N 名找得到自己算通過；險種通過率低於門檻標示「檢索品質異常」
INGEST_SELFCHECK_TOP_N=3
INGEST_SELFCHECK_MIN_PASS_RATE=0.95

# 保單上傳（功能二）：檔案大小上限（MB）
POLICY_MAX_UPLOAD_MB=10

# 事件流程的 agent 實作：fake，或 backend/app/agents/registry.py 註冊的名稱（ADR-0015）
AGENT_5_IMPL=fake
AGENT_6_IMPL=fake
AGENT_7_IMPL=fake
# 5 號 v1（AGENT_5_IMPL=v1）的 Jev 守門金鑰（TypeSafe 後台取得）；留空就不守門
TYPESAFE_API_KEY=

# 使用者登入
# session cookie 的簽章密鑰；產生：openssl rand -hex 32。沒設時每次啟動都換一個，重啟後要重新登入
SESSION_SECRET=
# 測試登入（任何 email 都能登入），給本機開發與 e2e 用。
# 用 ngrok 等方式把開發環境分享給別人時要改成 false；正式環境永遠無效
DEV_LOGIN_ENABLED=true
# Google 登入與授權（ADR-0020）：四個都填才會出現 Google 登入；只用測試登入時可以留空。
# OAuth 用戶端與測試使用者名單見 docs/agents/dev-environment.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 使用者在瀏覽器看到的網址；Google Cloud 要登記 ${PUBLIC_BASE_URL}/api/v1/auth/google/callback
PUBLIC_BASE_URL=http://localhost:5173
# 加密 Google refresh token 的金鑰；產生：uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 換掉它會讓所有人的 Google 授權失效，要重新授權
TOKEN_ENCRYPTION_KEY=

# Azure OpenAI（LLM_PROVIDER=azure_openai 時必填，API_VERSION 有預設值）
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# OpenAI（LLM_PROVIDER=openai 時 API_KEY 必填，model 有預設值）
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# TypeSafe（Jev）：1-4 方案問答擋無關問題與 prompt injection；沒設就跳過這道檢查（log 會警告）
TYPESAFE_API_KEY=

# Ollama（選用，需先在本機安裝並 ollama pull 下列 model）
# compose 裡的 backend 會把 OLLAMA_BASE_URL 覆寫成 http://host.docker.internal:11434 連本機 Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# 6 號文件辨識（ADR-0022）：照片與掃描檔用 Azure Document Intelligence 讀文字。
# 端點或金鑰沒設時，照片與掃描檔回「不確定」；電子 PDF 不受影響。MODEL 是 read 或 layout
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
AZURE_DOCUMENT_INTELLIGENCE_MODEL=read
# 資源所在區域（例如 eastasia），只作記錄，呼叫以 ENDPOINT 為準
AZURE_DOCUMENT_INTELLIGENCE_REGION=
# 逐欄信心度門檻，低於它請使用者重拍
DOCUMENT_FIELD_CONFIDENCE=0.8
# 文件辨識驗收資料集（repo 外的資料夾，只給 make eval-documents 用）
DOCUMENT_EVAL_DIR=
# 開發與展示用：沒有 Google 授權時用假的雲端存檔（檔案不會真的存起來），正式環境不可打開
DOCUMENT_DEV_FAKE_STORAGE=false
