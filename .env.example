# 複製成 .env 後依需要修改：cp .env.example .env
# .env 不進 git；compose 與後端（pydantic-settings）都會讀這份

# 環境：local（開發）、test（pytest 自動切換）、production（正式環境）
ENVIRONMENT=local

# 資料庫連線；compose 裡的 backend 會把 POSTGRES_SERVER 覆寫成 db、POSTGRES_PORT 覆寫成 5432
POSTGRES_SERVER=localhost
# 同時是開發 compose 的 db 對外 port 與本機（make test、make migrate）連線的 port，衝突時只改這裡
POSTGRES_PORT=5432
POSTGRES_USER=postgres
# 改密碼要一起改 docker/pgadmin/servers.json，且只在 DB volume 第一次建立時生效
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gae265_03_group_project
# 測試資料庫，名稱必須以 _test 結尾
POSTGRES_TEST_DB=gae265_03_group_project_test

# 開發 compose 對外的 port；跟本機其他服務衝突時改這裡
PGADMIN_PORT=5050
BACKEND_PORT=8000
FRONTEND_PORT=5173

# 費率表與門檻等資料目錄；預設 backend/data，一般不用設
# DATA_DIR=

# LLM 與 embedding 供應商：azure_openai（開發預設，用開發專用 deployment）、openai、ollama
# 所選供應商缺必填設定時後端啟動即報錯；測試一律用 fake，不需要以下任何設定
LLM_PROVIDER=azure_openai

# 條文向量的維度（資料表欄位與 embedding 都用這個值）；Azure／OpenAI 會縮到這個維度，
# Ollama 要選同維度的 model（bge-m3 = 1024）。改了要新的 migration 並重建向量
EMBEDDING_DIMENSIONS=1024

# 條款上傳（ingest agent，僅非 production）：檔案大小上限（MB）、判定為條款至少要切出的條文數
INGEST_MAX_UPLOAD_MB=30
INGEST_MIN_ARTICLES=5

# Azure OpenAI（LLM_PROVIDER=azure_openai 時必填，API_VERSION 有預設值）
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# OpenAI（LLM_PROVIDER=openai 時 API_KEY 必填，model 有預設值）
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ollama（選用，需先在本機安裝並 ollama pull 下列 model）
# compose 裡的 backend 會把 OLLAMA_BASE_URL 覆寫成 http://host.docker.internal:11434 連本機 Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
