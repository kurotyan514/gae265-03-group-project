# 正式環境（compose.prod.yaml）的設定：在 VM 上 cp .env.prod.example .env 後修改
# .env 不進 git；secrets 只放在 VM 的 .env

# Caddy 的網域：設真實網域（例 <名稱>.<區域>.cloudapp.azure.com）時自動申請 Let's Encrypt 憑證，
# 網域要先指向 VM，且 VM 的 80、443 要對外開放；本機驗證用 localhost
DOMAIN=localhost

# Caddy 對外的 port；正式環境維持 80、443（Let's Encrypt 驗證需要），本機驗證衝突時才改
HTTP_PORT=80
HTTPS_PORT=443

# 資料庫：密碼必填、請用強密碼；只在 DB volume 第一次建立時生效，之後改密碼要進資料庫改
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=gae265_03_group_project

# LLM 與 embedding：正式環境用 Azure OpenAI（VM 跑不動本機模型，見 docs/adr/0001），以下皆必填，缺少時後端啟動即報錯
LLM_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# 使用者登入（Google OAuth）：以下前三項必填，缺少時後端啟動即報錯。
# Google Cloud 的「已授權的重新導向 URI」要登記 ${PUBLIC_BASE_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# session cookie 的簽章密鑰；產生：openssl rand -hex 32。換掉它會讓所有人登出
SESSION_SECRET=
# 使用者在瀏覽器看到的網址，要和 DOMAIN 一致並用 https，例如 https://<DOMAIN>
PUBLIC_BASE_URL=https://localhost
# 可登入的 email，以逗號分隔；留空代表任何 Google 帳號都能登入
ALLOWED_EMAILS=

# 條文向量的維度；與資料表欄位一致，沒有特別理由不要改
EMBEDDING_DIMENSIONS=1024
