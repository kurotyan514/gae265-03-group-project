# 正式環境（compose.prod.yaml）的設定：在 VM 上 cp .env.prod.example .env 後修改
# .env 不進 git；secrets 只放在 VM 的 .env

# Caddy 的網域：設真實網域（例 <名稱>.<區域>.cloudapp.azure.com）時自動申請 Let's Encrypt 憑證，
# 網域要先指向 VM，且 VM 的 80、443 要對外開放；本機驗證用 localhost
DOMAIN=localhost

# Caddy 對外的 port；正式環境維持 80、443（Let's Encrypt 驗證需要），本機驗證衝突時才改
HTTP_PORT=80
HTTPS_PORT=443

# 資料庫：密碼必填、請用強密碼；只在 DB volume 第一次建立時生效，之後改密碼要進資料庫改
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=gae265_03_group_project
